# Environment variables for Frappe Builder with Docker
# Copy this file to `.env` and adjust the values to your needs:
#
#   cp example.env .env
#
# Then start the stack with:
#
#   docker compose up -d
#
# All variables are optional and have safe defaults, so you can run the stack
# as-is. At minimum, change DB_PASSWORD and SITE_ADMIN_PASSWORD in production.
#
# Two image lines are published from the same repository:
#   stable - Builder master releases (recommended for production)
#   edge   - Builder develop, newest features, may change daily
# Pin a specific version in production so deploys are reproducible.

# --- Image -------------------------------------------------------------

# Docker image to run.
BUILDER_IMAGE=mitexleo/sysplore-builder

# Image tag. Supported values:
#   stable          stable line, most recent     (default)
#   latest / edge   edge line, most recent
#   1.1.3           a pinned stable version
#   edge-1.0.9      a pinned edge version
BUILDER_TAG=stable

# --- Database ----------------------------------------------------------

# MariaDB root password. Used by the database service and site creation.
# CHANGE THIS IN PRODUCTION.
DB_PASSWORD=admin

# --- Site --------------------------------------------------------------

# Name of the Frappe site created on first run.
SITE_NAME=frontend

# Administrator login password. Used to log in as "Administrator".
# CHANGE THIS IN PRODUCTION.
SITE_ADMIN_PASSWORD=admin

# --- Networking --------------------------------------------------------

# Host port the site is published on (default 8080).
HTTP_PUBLISH_PORT=8080

# Site name resolved by host header. Default is $$host, which resolves the
# site by the request host (e.g. example.com). To force a specific site
# regardless of host, set this to your SITE_NAME.
FRAPPE_SITE_NAME_HEADER=

# --- Application -------------------------------------------------------

# Gunicorn settings. Tune for throughput on production hardware.
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Frontend (nginx) --------------------------------------------------

# Trusted upstream IP address and header, for correct client IP behind proxies.
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off

# Nginx proxy- and body-size limits. Increase CLIENT_MAX_BODY_SIZE if you
# raise the upload limit in the application.
PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m